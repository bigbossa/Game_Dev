{
  "name": "dharma-adharma-online",
  "version": "0.1.0",
  "description": "2D MMORPG - ธรรมะ vs อธรรม",
  "main": "server/index.js",
  "scripts": {
    "check:maps": "node tools/check-hunting-maps.cjs",
    "check:maps-browser": "node tools/check-hunting-browser.cjs",
    "preview:maps": "node tools/preview-hunting.cjs",
    "warrior": "node tools/build-warrior.cjs && node tools/build-warrior-v2.cjs --v4 && node tools/build-warrior-gear.cjs",
    "check:warrior": "node tools/check-warrior.cjs && node tools/check-warrior-art.cjs",
    "check:warrior-browser": "node tools/check-warrior-browser.cjs",
    "check:warrior-model": "node tools/check-warrior-model.cjs",
    "check:warrior-parity": "node tools/check-warrior-parity.cjs",
    "audit:balance": "node tools/audit-class-balance.cjs",
    "check:gm-exp": "node tools/check-gm-exp.cjs",
    "sprites": "node tools/build-sprites.js && node tools/item-icons.js && node tools/armor-masks.js && node tools/weapon-sprites.js",
    "monsters": "node tools/build-monsters.js",
    "kingboar": "node tools/build-kingboar.cjs",
    "monsters:village": "node tools/build-village-monsters.cjs",
    "check:monsters-village": "node tools/check-village-monsters.cjs",
    "check:monsters-village-browser": "node tools/check-village-monsters-browser.cjs",
    "check:kingboar": "node tools/check-kingboar.cjs",
    "check:kingboar-browser": "node tools/check-kingboar-browser.cjs",
    "monster-prompts": "node tools/build-monsters.js --prompts",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "taoist": "node tools/build-taoist-v2.cjs",
    "taoist:legacy": "node tools/build-taoist.js",
    "village": "node tools/build-village.cjs",
    "check:village": "node tools/check-village.cjs",
    "check:village-browser": "node tools/check-village-browser.cjs",
    "check:taoist": "node tools/check-taoist-v2.cjs",
    "check:taoist-browser": "node tools/check-taoist-v2-browser.cjs",
    "archer": "node tools/build-archer-v2.cjs && node tools/build-archer-v2.cjs --adharma-hair",
    "archer:legacy": "node tools/build-archer.js",
    "adharma-hair": "node tools/build-dualblade-v2.cjs --adharma-hair && node tools/build-archer-v2.cjs --adharma-hair && node tools/build-spearman.js --adharma-hair",
    "check:archer-browser": "node tools/check-archer-v2.cjs",
    "check:archer-rig": "node tools/check-archer-rig.cjs",
    "check:monster-skills": "node tools/check-monster-skills.cjs",
    "check:feral-browser": "node tools/check-feral-browser.cjs",
    "spearman": "node tools/build-spearman.js",
    "dualblade": "node tools/build-dualblade-v2.cjs",
    "check:dualblade-browser": "node tools/check-dualblade-v2.cjs",
    "check:spearman": "node tools/check-spearman.cjs",
    "check:skill-performance": "node tools/check-skill-performance.cjs",
    "check:ascended": "node tools/check-ascended.cjs",
    "drop-table": "node tools/drop-table.cjs",
    "gear-gate": "node tools/gear-gate.cjs",
    "check:drops": "node tools/check-drop-guide.cjs && node tools/drop-table.cjs --check",
    "gm": "node tools/gm.cjs",
    "migrate:supabase": "node tools/migrate-to-supabase.cjs",
    "icons": "node tools/build-icons.cjs"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
